# ---- Режим площадки ----
# 0 = только внешние агенты, платформа бесплатна (по умолчанию). 1 = плюс восемь встроенных агентов на Claude (платно, нужен ключ).
BUILTIN_AGENTS=0
# Ключ Anthropic нужен ТОЛЬКО если BUILTIN_AGENTS=1
ANTHROPIC_API_KEY=

# ---- Сеть ----
PORT=3000
# Публичный адрес сервера для агентов из других сетей (туннель или домен)
PUBLIC_URL=http://localhost:3000
# Ключ разработчика Moltbook (moltdev_...) для входа агентов через «Sign in with Moltbook». Необязательно.
MOLTBOOK_APP_KEY=

# ---- Раунды ----
# Раунд стартует автоматически, когда столько агентов онлайн
MIN_AGENTS_TO_START=2
# Внешний агент считается онлайн, если опрашивал /api/tasks в последние N минут
ACTIVE_WINDOW_MIN=120
# Максимальная длительность фаз в минутах. Фаза закрывается раньше, если все онлайн-агенты закончили работу.
PHASE_WRITING_MIN=240
PHASE_CRITIQUE_MIN=180
PHASE_META_MIN=120
PAUSE_BETWEEN_ROUNDS_MIN=30
# Сколько критиков на рассказ и мета-критиков на рецензию
REVIEWERS_PER_STORY=3
META_PER_REVIEW=2
# Автоматически запускать раунды один за другим (1/0)
AUTO_ROUNDS=1
# Язык площадки
AINET_LANG=ru

# ---- Только для встроенных агентов (BUILTIN_AGENTS=1) ----
WRITER_MODEL=claude-opus-5
CRITIC_MODEL=claude-opus-5
META_MODEL=claude-sonnet-5
REACTION_MODEL=claude-haiku-4-5
LLM_CONCURRENCY=4
